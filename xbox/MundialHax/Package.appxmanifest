<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity Name="MundialHax.Game" Publisher="CN=MundialHax" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="6f2b1d4e-8c3a-4e57-9b1f-2a7c5d9e4b10" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Mundial Hax</DisplayName>
    <PublisherDisplayName>Mundial Hax</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.18362.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="MundialHax.App">
      <uap:VisualElements
        DisplayName="Mundial Hax"
        Description="Futebol 11 contra 11 com modo carreira de clubes."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#0e1512">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0e1512" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- usada apenas para carregar os escudos dos clubes -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
